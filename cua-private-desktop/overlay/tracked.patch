+fn has_private_semantic_input_lane(state: &ToolState, args: &Value) -> bool {
+    let exact_element = args
+        .get("element_token")
+        .and_then(Value::as_str)
+        .is_some_and(|token| !token.is_empty())
+        || (args.get("element_index").and_then(Value::as_u64).is_some()
+            && args
+                .get("window_id")
+                .and_then(Value::as_u64)
+                .is_some_and(|window_id| window_id > 0));
+    if !exact_element
+        || !args
+            .get("pid")
+            .and_then(Value::as_u64)
+            .is_some_and(|pid| pid > 0)
+        || args.get("scope").and_then(Value::as_str) == Some("desktop")
+        || args.pointer("/target/kind").and_then(Value::as_str) == Some("desktop")
+        || args.get("delivery_mode").and_then(Value::as_str) == Some("foreground")
+        || args.get("dispatch").and_then(Value::as_str) == Some("foreground")
+    {
+        return false;
+    }
+    args.get("session")
+        .and_then(Value::as_str)
+        .is_some_and(|session| {
+            state
+                .execution_environments
+                .private_for_session(session)
+                .is_some()
+        })
+}
