+unsafe fn walk_live_flat_bounded(
+    automation: &IUIAutomation,
+    root: &IUIAutomationElement,
+    max_elements: usize,
+) -> (Vec<UiaNode>, Vec<(usize, String)>) {
+    // WinUI 3 on a private desktop can expose descendants to targeted
+    // PropertyCondition queries while returning an empty result for a single
+    // TrueCondition subtree enumeration. Mirror the proven B3 strategy by
+    // querying concrete UIA ControlType properties and merging the results.
+    let mut nodes = Vec::new();
+    let mut lines = Vec::new();
+    let mut counter = 0usize;
+
+    'types: for control_type_id in 50000i32..=50040i32 {
+        if nodes.len() >= max_elements {
+            break;
+        }
+        let condition = match automation
+            .CreatePropertyCondition(UIA_ControlTypePropertyId, &control_type_id.into())
+        {
+            Ok(condition) => condition,
+            Err(_) => continue,
+        };
+        let elements = match root.FindAll(TreeScope_Subtree, &condition) {
+            Ok(elements) => elements,
+            Err(_) => continue,
+        };
+        let count = elements.Length().unwrap_or(0).max(0) as usize;
+        for index in 0..count {
+            if nodes.len() >= max_elements {
+                break 'types;
+            }
+            let Ok(element) = elements.GetElement(index as i32) else {
+                continue;
+            };
+            let control_type = element
+                .CurrentControlType()
+                .ok()
+                .map(|value| control_type_name(value.0))
+                .unwrap_or_else(|| control_type_name(control_type_id));
+            let name = current_nonempty_bstr(element.CurrentName());
+            let value = read_current_bstr_property(&element, UIA_ValueValuePropertyId);
+            let automation_id = current_nonempty_bstr(element.CurrentAutomationId());
+            let enabled = read_current_bool_property(&element, UIA_IsEnabledPropertyId);
+            let is_enabled = enabled.unwrap_or(true);
+            let selected = read_current_selected(&element);
+            let actions = detect_current_actions(&element, &control_type, is_enabled);
+            let is_actionable = !actions.is_empty() && is_enabled;
+            let has_content = name.as_deref().is_some_and(|text| !text.trim().is_empty())
+                || value.as_deref().is_some_and(|text| !text.trim().is_empty());
+            if !is_actionable && !has_content {
+                continue;
+            }
+
+            let retained = element.clone();
+            let element_ptr = retained.as_raw() as usize;
+            std::mem::forget(retained);
+            let (center_x, center_y, rect) = match element.CurrentBoundingRectangle() {
+                Ok(rect) if rect.right > rect.left && rect.bottom > rect.top => (
+                    (rect.left + rect.right) / 2,
+                    (rect.top + rect.bottom) / 2,
+                    Some((rect.left, rect.top, rect.right, rect.bottom)),
+                ),
+                _ => (0, 0, None),
+            };
+            let element_index = if is_actionable {
+                let current = counter;
+                counter += 1;
+                Some(current)
+            } else {
+                None
+            };
+            let node = UiaNode {
+                element_index,
+                control_type,
+                name,
+                value,
+                automation_id,
+                help_text: None,
+                actions,
+                enabled,
+                selected,
+                element_ptr,
+                center_x,
+                center_y,
+                rect,
+                msaa_role: None,
+                depth: 1,
+                parent_element_index: None,
+                in_web_content: false,
+            };
+            lines.push((node.depth, format_node_line(&node)));
+            nodes.push(node);
+        }
+    }
+
+    (nodes, lines)
+}
