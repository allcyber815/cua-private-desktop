+                .get("session")
+                .and_then(Value::as_str)
+                .filter(|session| !session.is_empty())
+                .map(str::to_owned)
+        })
+        .unwrap_or_else(|| transport_session.to_owned());
+    let mut hasher = DefaultHasher::new();
+    session.hash(&mut hasher);
+    (hasher.finish() as usize) % LEGACY_SESSION_LANES
