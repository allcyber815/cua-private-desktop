+/// Read the current worker and target-window mandatory integrity RIDs.
+///
+/// This probe is fail-closed for private-desktop policy gates: inability to
+/// prove the relationship is returned as an error rather than interpreted as
+/// "not blocked".
+pub fn window_integrity_pair(hwnd: u64) -> Result<(u32, u32), String> {
+    let h = HWND(hwnd as *mut _);
+    let mut pid: u32 = 0;
+    if unsafe { GetWindowThreadProcessId(h, Some(&mut pid)) } == 0 || pid == 0 {
+        return Err(format!("could not resolve target pid for hwnd 0x{hwnd:x}"));
+    }
+
+    let own = unsafe { process_integrity_rid(GetCurrentProcess()) }
+        .ok_or_else(|| "could not read cua-driver integrity RID".to_string())?;
+
+    let target_handle = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }
+        .map_err(|error| {
+            format!("could not open target pid {pid} for integrity inspection: {error}")
+        })?;
+    let target = unsafe { process_integrity_rid(target_handle) };
+    let _ = unsafe { CloseHandle(target_handle) };
+    let target =
+        target.ok_or_else(|| format!("could not read integrity RID for target pid {pid}"))?;
+
+    Ok((own, target))
+}
