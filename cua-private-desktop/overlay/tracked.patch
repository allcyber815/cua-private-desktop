+unsafe fn is_winui_desktop_window(hwnd: windows::Win32::Foundation::HWND) -> bool {
+    use windows::Win32::UI::WindowsAndMessaging::GetClassNameW;
+    let mut buffer = [0u16; 128];
+    let len = GetClassNameW(hwnd, &mut buffer);
+    len > 0
+        && String::from_utf16_lossy(&buffer[..len as usize])
+            .eq_ignore_ascii_case("WinUIDesktopWin32WindowClass")
+}
+
+fn current_nonempty_bstr(value: windows::core::Result<BSTR>) -> Option<String> {
+    let value = value.ok()?.to_string();
+    (!value.trim().is_empty()).then_some(value)
+}
+
+fn read_current_bstr_property(
+    element: &IUIAutomationElement,
+    property_id: windows::Win32::UI::Accessibility::UIA_PROPERTY_ID,
+) -> Option<String> {
+    unsafe {
+        let variant = element.GetCurrentPropertyValue(property_id).ok()?;
+        if variant.as_raw().Anonymous.Anonymous.vt != 8 {
+            return None;
+        }
+        let bstr = BSTR::from_raw(variant.as_raw().Anonymous.Anonymous.Anonymous.bstrVal);
+        let value = bstr.to_string();
+        std::mem::forget(bstr);
+        (!value.trim().is_empty()).then_some(value)
+    }
+}
+
+fn read_current_bool_property(
+    element: &IUIAutomationElement,
+    property_id: windows::Win32::UI::Accessibility::UIA_PROPERTY_ID,
+) -> Option<bool> {
+    unsafe {
+        let variant = element.GetCurrentPropertyValue(property_id).ok()?;
+        (variant.as_raw().Anonymous.Anonymous.vt == 11)
+            .then(|| variant.as_raw().Anonymous.Anonymous.Anonymous.boolVal != 0)
+    }
+}
+
+fn read_current_selected(element: &IUIAutomationElement) -> Option<bool> {
+    unsafe {
+        if let Ok(pattern) = element.GetCurrentPattern(UIA_TogglePatternId) {
+            if let Ok(toggle) = pattern.cast::<IUIAutomationTogglePattern>() {
+                return match toggle.CurrentToggleState() {
+                    Ok(state) if state == ToggleState_On => Some(true),
+                    Ok(state) if state == ToggleState_Off => Some(false),
+                    _ => None,
+                };
+            }
+        }
+        if let Ok(pattern) = element.GetCurrentPattern(UIA_SelectionItemPatternId) {
+            if let Ok(selection) = pattern.cast::<IUIAutomationSelectionItemPattern>() {
+                return selection
+                    .CurrentIsSelected()
+                    .ok()
+                    .map(|value| value.as_bool());
+            }
+        }
+    }
+    None
+}
+
+fn detect_current_actions(
+    element: &IUIAutomationElement,
+    control_type: &str,
+    is_enabled: bool,
+) -> Vec<String> {
+    if !is_enabled {
+        return Vec::new();
+    }
+    let mut actions = Vec::new();
+    unsafe {
+        if element.GetCurrentPattern(UIA_InvokePatternId).is_ok() {
+            actions.push("invoke".into());
+        }
+        if element.GetCurrentPattern(UIA_TogglePatternId).is_ok() {
+            actions.push("toggle".into());
+        }
+        if element
+            .GetCurrentPattern(UIA_SelectionItemPatternId)
+            .is_ok()
+        {
+            actions.push("select".into());
+        }
+        if element
+            .GetCurrentPattern(UIA_ExpandCollapsePatternId)
+            .is_ok()
+        {
+            actions.push("expand".into());
+        }
+        if element.GetCurrentPattern(UIA_ValuePatternId).is_ok()
+            || element.GetCurrentPattern(UIA_RangeValuePatternId).is_ok()
+        {
+            actions.push("set_value".into());
+        }
+        if element.GetCurrentPattern(UIA_TextPatternId).is_ok() {
+            actions.push("text".into());
+        }
+        if element.GetCurrentPattern(UIA_ScrollPatternId).is_ok() {
+            actions.push("scroll".into());
+        }
+    }
+    if actions.is_empty() && control_type == "MenuItem" {
+        actions.push("invoke".into());
+    }
+    actions
+}
+
+unsafe fn walk_live_flat_bounded(
+    automation: &IUIAutomation,
+    root: &IUIAutomationElement,
+    max_elements: usize,
+) -> (Vec<UiaNode>, Vec<(usize, String)>) {
+    // WinUI 3 on a private desktop can expose descendants to targeted
+    // PropertyCondition queries while returning an empty result for a single
+    // TrueCondition subtree enumeration. Mirror the proven B3 strategy by
+    // querying concrete UIA ControlType properties and merging the results.
+    let mut nodes = Vec::new();
+    let mut lines = Vec::new();
+    let mut counter = 0usize;
+
+    'types: for control_type_id in 50000i32..=50040i32 {
+        if nodes.len() >= max_elements {
+            break;
+        }
+        let condition = match automation
+            .CreatePropertyCondition(UIA_ControlTypePropertyId, &control_type_id.into())
+        {
+            Ok(condition) => condition,
+            Err(_) => continue,
+        };
+        let elements = match root.FindAll(TreeScope_Subtree, &condition) {
+            Ok(elements) => elements,
+            Err(_) => continue,
+        };
+        let count = elements.Length().unwrap_or(0).max(0) as usize;
+        for index in 0..count {
+            if nodes.len() >= max_elements {
+                break 'types;
+            }
+            let Ok(element) = elements.GetElement(index as i32) else {
+                continue;
+            };
+            let control_type = element
+                .CurrentControlType()
+                .ok()
+                .map(|value| control_type_name(value.0))
+                .unwrap_or_else(|| control_type_name(control_type_id));
+            let name = current_nonempty_bstr(element.CurrentName());
+            let value = read_current_bstr_property(&element, UIA_ValueValuePropertyId);
+            let automation_id = current_nonempty_bstr(element.CurrentAutomationId());
+            let enabled = read_current_bool_property(&element, UIA_IsEnabledPropertyId);
+            let is_enabled = enabled.unwrap_or(true);
+            let selected = read_current_selected(&element);
+            let actions = detect_current_actions(&element, &control_type, is_enabled);
+            let is_actionable = !actions.is_empty() && is_enabled;
+            let has_content = name.as_deref().is_some_and(|text| !text.trim().is_empty())
+                || value.as_deref().is_some_and(|text| !text.trim().is_empty());
+            if !is_actionable && !has_content {
+                continue;
+            }
+
+            let retained = element.clone();
+            let element_ptr = retained.as_raw() as usize;
+            std::mem::forget(retained);
+            let (center_x, center_y, rect) = match element.CurrentBoundingRectangle() {
+                Ok(rect) if rect.right > rect.left && rect.bottom > rect.top => (
+                    (rect.left + rect.right) / 2,
+                    (rect.top + rect.bottom) / 2,
+                    Some((rect.left, rect.top, rect.right, rect.bottom)),
+                ),
+                _ => (0, 0, None),
+            };
+            let element_index = if is_actionable {
+                let current = counter;
+                counter += 1;
+                Some(current)
+            } else {
+                None
+            };
+            let node = UiaNode {
+                element_index,
+                control_type,
+                name,
+                value,
+                automation_id,
+                help_text: None,
+                actions,
+                enabled,
+                selected,
+                element_ptr,
+                center_x,
+                center_y,
+                rect,
+                msaa_role: None,
+                depth: 1,
+                parent_element_index: None,
+                in_web_content: false,
+            };
+            lines.push((node.depth, format_node_line(&node)));
+            nodes.push(node);
+        }
+    }
+
+    (nodes, lines)
+}
