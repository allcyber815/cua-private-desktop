+/// Post one background mouse-move at screen coordinates without moving the
+/// real OS cursor or activating the target window.
+///
+/// The exact root HWND constrains hit-testing. The event is delivered to the
+/// deepest child at the point so native controls receive the same client-space
+/// WM_MOUSEMOVE they would see from a real pointer. This is intentionally a
+/// message-only hover primitive: callers that require the system input queue
+/// must use an explicit foreground/global-input lane instead.
+pub fn post_mouse_move_screen(root: u64, sx: i32, sy: i32) -> Result<()> {
+    let root_hwnd = HWND(root as *mut _);
+    let screen_pt = POINT { x: sx, y: sy };
+    let (target, client) = deepest_child(root_hwnd, screen_pt);
+
+    if let Some(msg) = crate::input::post_message_blocked_by_uipi(target.0 as u64) {
+        anyhow::bail!(msg);
+    }
+
+    let prev_fg = unsafe { GetForegroundWindow() };
+    let target_root = unsafe {
+        let root = GetAncestor(target, GA_ROOT);
+        if root.0.is_null() {
+            target
+        } else {
+            root
+        }
+    };
+    let _noact = crate::input::NoActivateGuard::arm(target);
+    unsafe {
+        PostMessageW(
+            target,
+            WM_MOUSEMOVE,
+            WPARAM(0),
+            make_lparam(client.x, client.y),
+        )?;
+    }
+
+    // Allow the receiver's message pump to run while the no-activate guard is
+    // still armed. If a misbehaving host nevertheless foregrounds itself,
+    // restore the user's prior foreground before reporting completion.
+    sleep(Duration::from_millis(50));
+    unsafe {
+        if !prev_fg.0.is_null() && prev_fg != target_root && GetForegroundWindow() == target_root {
+            crate::input::force_foreground_attached(prev_fg);
+            sleep(Duration::from_millis(12));
+            crate::input::force_foreground_attached(prev_fg);
+        }
+    }
+    Ok(())
+}
