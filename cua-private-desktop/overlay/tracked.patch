+    let detail = format!(
+        "PrintWindow A/B/C verified: attempts={}; baseline_changed={}; baseline_diff_sum={}; baseline_noise_masked={}; baseline_noise_limit={}; mutation_changed={}; mutation_diff_sum={}; sentinel_post={}",
+        receipt["visual_baseline_attempts"].as_u64().unwrap_or(0),
+        receipt["baseline_changed"].as_u64().unwrap_or(0),
+        receipt["baseline_diff_sum"].as_u64().unwrap_or(0),
+        receipt["baseline_noise_masked_samples"].as_u64().unwrap_or(0),
+        receipt["baseline_noise_limit"].as_u64().unwrap_or(0),
+        receipt["mutation_changed"].as_u64().unwrap_or(0),
+        receipt["mutation_diff_sum"].as_u64().unwrap_or(0),
+        receipt["post_sentinel_count"].as_u64().unwrap_or(0),
+    );
+
+    if let Some(record) = result.action_record.as_mut() {
+        use cua_driver_contract::{
+            ActionVisualObserver, ActionVisualReceipt, ActionVisualWindowState,
+        };
+        use cua_driver_core::action_record::{ActionEvidence, EvidenceKind};
+        record.evidence.push(ActionEvidence {
+            kind: EvidenceKind::ScreenshotComparison,
