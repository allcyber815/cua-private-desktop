+    /// Retain every element from the current snapshot for one exact window.
+    ///
+    /// The cache lock is held only while cloning payload-owned handles. Live
+    /// provider calls must happen after this method returns so a slow UIA
+    /// provider can never block snapshot publication or retirement.
+    pub fn retain_window_elements(&self, pid: i32, window_id: u64) -> Option<Vec<S::Element>> {
+        if current_runtime_scope() != self.runtime_scope {
+            return None;
+        }
+        let inner = self.inner.lock().unwrap();
+        let entry = inner
+            .snapshots
+            .get(&pid)?
+            .iter()
+            .find(|entry| entry.window_id == window_id)?;
+        Some(
+            (0..entry.payload.len())
+                .filter_map(|index| entry.payload.retain(index))
+                .collect(),
+        )
+    }
