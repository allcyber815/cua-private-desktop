+/// Invoke an advertised accelerator on a worker that is already attached to
+/// the target desktop.
+///
+/// Unlike [`try_invoke_accelerator_in_window`], this entry point deliberately
+/// does not spawn the process-wide deadline worker because a newly-created
+/// thread would lose the caller's Win32 desktop affinity. Private-desktop
+/// callers must run this from their attached bounded worker; the enclosing
+/// private runtime supplies the outer reply deadline and fail-closed teardown
+/// contract.
+pub fn try_invoke_accelerator_in_attached_window(
+    hwnd: isize,
+    combo: &str,
+) -> anyhow::Result<(bool, usize)> {
+    let cancelled = AtomicBool::new(false);
+    try_invoke_accelerator_in_window_unbounded(hwnd, combo, &cancelled)
+}
