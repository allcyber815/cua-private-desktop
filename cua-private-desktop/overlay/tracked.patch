+/// Detect a WinUI 3 XAML Island hosted below a classic Win32/WinForms frame.
+/// The private-desktop capability matrix treats this provider differently from
+/// ordinary WinForms, so a false-negative here must not silently select the
+/// classic HWND message adapter.
+pub fn has_xaml_island_descendant(hwnd: u64) -> bool {
+    use windows::Win32::Foundation::{BOOL, FALSE, HWND, LPARAM, TRUE};
+    use windows::Win32::UI::WindowsAndMessaging::{EnumChildWindows, GetClassNameW};
+
+    if hwnd == 0 {
+        return false;
+    }
+
+    struct Scan {
+        found: bool,
+    }
+    unsafe extern "system" fn child_cb(child: HWND, lparam: LPARAM) -> BOOL {
+        let scan = &mut *(lparam.0 as *mut Scan);
+        let mut buf = [0u16; 128];
+        let n = GetClassNameW(child, &mut buf);
+        if n > 0 {
+            let class = String::from_utf16_lossy(&buf[..n as usize]);
+            if class == "Microsoft.UI.Content.DesktopChildSiteBridge"
+                || class == "InputSiteWindowClass"
+            {
+                scan.found = true;
+                return FALSE;
+            }
+        }
+        TRUE
+    }
+
+    let mut scan = Scan { found: false };
+    unsafe {
+        let _ = EnumChildWindows(
+            HWND(hwnd as *mut _),
+            Some(child_cb),
+            LPARAM(&mut scan as *mut Scan as isize),
+        );
+    }
+    scan.found
+}
