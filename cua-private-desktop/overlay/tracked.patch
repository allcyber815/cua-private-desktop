+                "screen_x": sx,
+                "screen_y": sy,
+                "button": button,
+                "click_count": count,
+                "path": "PostMessage",
+                "foreground_fallback_allowed": false,
+            }))
+            .with_action_record(record)
+        }
+        Ok(Err(error)) => ToolResult::error(error.to_string()).with_structured(json!({
+            "code": "private_pointer_transport_failed",
+            "isolation_mode": "private_desktop",
+            "action": action,
+            "pid": pid,
+            "window_id": hwnd,
+            "foreground_fallback_allowed": false,
+            "action_performed": false,
+        })),
+        Err(error) => ToolResult::error(format!("private_desktop {action} task failed: {error}"))
+            .with_structured(json!({
+                "code": "private_pointer_task_failed",
+                "isolation_mode": "private_desktop",
+                "action": action,
+                "pid": pid,
+                "window_id": hwnd,
+                "foreground_fallback_allowed": false,
+                "action_performed": false,
+            })),
+    };
+
+    complete_private_interference_result(action_result, interference)
+}
+
+async fn private_desktop_posted_pointer_move(
+    environment: Arc<crate::execution_environment::PrivateEnvironmentHandle>,
+    pid: u32,
+    hwnd: u64,
+    sx: i32,
+    sy: i32,
+) -> ToolResult {
+    use cua_driver_core::action_record::{
+        ActionEffect, ActionExecutionRecord, ActionTransport, ActualDelivery, RequestedDelivery,
+    };
+
+    if crate::input::delivery::would_be_silently_dropped(
+        hwnd,
+        crate::input::delivery::EventKind::MouseMove,
+    ) {
+        return ToolResult::error(
+            "private_desktop move_cursor background hover is not verified for this target; global pointer injection is forbidden in the private lane",
+        )
+        .with_structured(json!({
+            "code": "background_unavailable",
+            "isolation_mode": "private_desktop",
+            "action": "move_cursor",
+            "event_kind": crate::input::delivery::EventKind::MouseMove.name(),
+            "pid": pid,
+            "window_id": hwnd,
+            "foreground_fallback_allowed": false,
+            "action_performed": false,
+        }));
+    }
+
+    if !crate::input::point_in_window_bounds(hwnd, sx, sy) {
+        return ToolResult::error(format!(
+            "private_desktop move_cursor point ({sx},{sy}) is outside window {hwnd}"
+        ))
+        .with_structured(json!({
+            "code": "pointer_point_outside_window",
+            "isolation_mode": "private_desktop",
+            "action": "move_cursor",
+            "pid": pid,
+            "window_id": hwnd,
+            "screen_x": sx,
+            "screen_y": sy,
+            "foreground_fallback_allowed": false,
+            "action_performed": false,
+        }));
+    }
+
+    let interference = match prepare_private_interference(&environment, pid) {
+        Ok(monitor) => monitor,
+        Err(result) => return result,
+    };
+    let environment_for_action = environment.clone();
+    let outcome = tokio::task::spawn_blocking(move || {
+        environment_for_action.run_attached_blocking(move || {
+            crate::input::mouse::post_mouse_move_screen(hwnd, sx, sy)
+        })
+    })
+    .await;
+
+    let action_result = match outcome {
+        Ok(Ok(())) => {
+            let record = ActionExecutionRecord::builder(
+                ActionEffect::Unverifiable,
+                ActionTransport::WindowsPostMessage,
+                RequestedDelivery::Background,
+            )
+            .actual_delivery(ActualDelivery::Background)
+            .detail(format!(
+                "private move_cursor posted WM_MOUSEMOVE to pid {pid} hwnd {hwnd} at screen ({sx},{sy}); no generic hover semantic postcondition is available"
+            ))
+            .build()
+            .expect("private posted pointer-move action record must be valid");
+            ToolResult::text(
+                "Sent background hover inside private_desktop via PostMessage without moving the real OS pointer.",
+            )
+            .with_structured(json!({
+                "isolation_mode": "private_desktop",
+                "action": "move_cursor",
+                "pid": pid,
+                "window_id": hwnd,
+                "screen_x": sx,
+                "screen_y": sy,
+                "path": "PostMessage(WM_MOUSEMOVE)",
+                "foreground_fallback_allowed": false,
+            }))
+            .with_action_record(record)
+        }
+        Ok(Err(error)) => ToolResult::error(error.to_string()).with_structured(json!({
+            "code": "private_pointer_transport_failed",
+            "isolation_mode": "private_desktop",
+            "action": "move_cursor",
+            "pid": pid,
+            "window_id": hwnd,
+            "foreground_fallback_allowed": false,
+            "action_performed": false,
+        })),
+        Err(error) => {
+            ToolResult::error(format!("private_desktop move_cursor task failed: {error}"))
+                .with_structured(json!({
+                    "code": "private_pointer_task_failed",
+                    "isolation_mode": "private_desktop",
+                    "action": "move_cursor",
+                    "pid": pid,
+                    "window_id": hwnd,
+                    "foreground_fallback_allowed": false,
+                    "action_performed": false,
+                }))
+        }
+    };
+
+    complete_private_interference_result(action_result, interference)
+}
+
+async fn private_desktop_semantic_click(
+    environment: Arc<crate::execution_environment::PrivateEnvironmentHandle>,
+    pid: u32,
+    hwnd: u64,
+    idx: usize,
+    admitted: crate::uia::cache::RetainedElement,
+    action_req: Option<String>,
+    verify_visual: bool,
+) -> ToolResult {
+    use crate::execution_environment::{PrivateActionTransport, PrivateSemanticAction};
+
+    if action_req.is_some() {
+        return ToolResult::error(
+            "private_desktop v1 does not admit explicit click action overrides; use the verified Invoke/Toggle/Selection semantic path.",
+        )
+        .with_structured(json!({
+            "code": "private_action_unsupported",
+            "isolation_mode": "private_desktop",
+            "pid": pid,
+            "window_id": hwnd,
+            "element_index": idx,
+        }));
+    }
+
+    let admitted_for_probe = admitted.clone();
+    let environment_for_probe = environment.clone();
+    let candidate = tokio::task::spawn_blocking(move || {
+        environment_for_probe.run_attached_blocking(move || -> anyhow::Result<PrivateSemanticAction> {
+            use windows::core::Interface;
+            use windows::Win32::UI::Accessibility::{
+                IUIAutomationElement, IUIAutomationInvokePattern,
+                IUIAutomationSelectionItemPattern, IUIAutomationTogglePattern,
+                UIA_InvokePatternId, UIA_SelectionItemPatternId, UIA_TogglePatternId,
+            };
+            let retained = admitted_for_probe;
+            if !retained.is_uia() {
+                anyhow::bail!(
+                    "private_desktop semantic click requires a UIA element; element [{idx}] uses another provider"
+                );
+            }
+            let element = std::mem::ManuallyDrop::new(unsafe {
+                IUIAutomationElement::from_raw(retained.as_ptr() as *mut _)
+            });
+            let has_invoke = unsafe { element.GetCurrentPattern(UIA_InvokePatternId) }
+                .and_then(|value| value.cast::<IUIAutomationInvokePattern>())
+                .is_ok();
+            let has_toggle = unsafe { element.GetCurrentPattern(UIA_TogglePatternId) }
+                .and_then(|value| value.cast::<IUIAutomationTogglePattern>())
+                .is_ok();
+            let has_select = unsafe { element.GetCurrentPattern(UIA_SelectionItemPatternId) }
+                .and_then(|value| value.cast::<IUIAutomationSelectionItemPattern>())
+                .is_ok();
+            if has_toggle {
+                Ok(PrivateSemanticAction::Toggle)
+            } else if has_select {
+                Ok(PrivateSemanticAction::Select)
+            } else if has_invoke {
+                Ok(PrivateSemanticAction::Invoke)
+            } else {
+                anyhow::bail!(
+                    "private_desktop element [{idx}] exposes no verified Invoke/Toggle/Selection UIA pattern"
+                )
+            }
+        })
+    })
+    .await;
+
+    let action = match candidate {
+        Ok(Ok(action)) => action,
+        Ok(Err(error)) => {
+            return ToolResult::error(error.to_string()).with_structured(json!({
+                "code": "private_semantic_pattern_unavailable",
+                "isolation_mode": "private_desktop",
+                "pid": pid,
+                "window_id": hwnd,
+                "element_index": idx,
+            }))
+        }
+        Err(error) => {
+            return ToolResult::error(format!(
+                "private_desktop semantic pattern probe task failed: {error}"
+            ))
+            .with_structured(json!({
+                "code": "private_semantic_probe_failed",
+                "isolation_mode": "private_desktop",
+                "pid": pid,
+                "window_id": hwnd,
+                "element_index": idx,
+            }))
+        }
+    };
+
+    let gate = match resolve_private_semantic_gate(environment.clone(), pid, hwnd, action).await {
+        Ok(gate) => gate,
+        Err(result) => return result,
+    };
+    let interference = match prepare_private_interference(&environment, pid) {
+        Ok(monitor) => monitor,
+        Err(result) => return result,
+    };
+    let visual_baseline =
+        match prepare_private_visual_verification(environment.clone(), hwnd, verify_visual).await {
+            Ok(baseline) => baseline,
+            Err(result) => return result,
+        };
+    if gate.decision.transport == Some(PrivateActionTransport::Win32Message) {
+        if gate.framework != crate::execution_environment::PrivateFramework::WinForms {
+            return ToolResult::error(format!(
+                "private_desktop native semantic transport is not implemented for provider {:?}",
+                gate.framework
+            ))
+            .with_structured(json!({
+                "code": "private_transport_unavailable",
+                "isolation_mode": "private_desktop",
+                "provider": format!("{:?}", gate.framework),
+                "action": format!("{action:?}"),
+                "transport": "Win32Message",
+            }));
+        }
+
+        let admitted_for_native = admitted.clone();
+        let environment_for_native = environment.clone();
+        let native = tokio::task::spawn_blocking(move || {
+            environment_for_native.run_attached_blocking(move || {
+                use windows::core::Interface;
+                use windows::Win32::UI::Accessibility::IUIAutomationElement;
+
+                let retained = admitted_for_native;
+                if !retained.is_uia() {
+                    anyhow::bail!(
+                        "private_desktop WinForms native adapter requires a UIA-resolved exact element"
+                    );
+                }
+                let element = std::mem::ManuallyDrop::new(unsafe {
+                    IUIAutomationElement::from_raw(retained.as_ptr() as *mut _)
+                });
+                crate::execution_environment::winforms_native::execute(&element, action, hwnd)
+            })
+        })
+        .await;
+
+        let native_result = match native {
+            Ok(Ok(receipt)) if receipt.semantic_verified == Some(true) => {
+                use cua_driver_core::action_record::{
+                    ActionEffect, ActionEvidence, ActionExecutionRecord, ActualDelivery,
+                    EvidenceKind, RequestedDelivery,
+                };
+                let record = ActionExecutionRecord::builder(
+                    ActionEffect::Confirmed,
+                    ActionTransport::WindowsPostMessage,
+                    RequestedDelivery::Background,
+                )
+                .actual_delivery(ActualDelivery::Background)
+                .evidence(ActionEvidence {
+                    kind: EvidenceKind::AccessibilityReadback,
+                    detail: receipt.postcondition_readback.clone(),
+                })
+                .detail(format!(
+                    "private WinForms {action:?} used {}; provider={:?}; state={:?}",
+                    receipt.actuator, gate.framework, gate.window_state
+                ))
+                .build()
+                .expect("verified WinForms private action record must be valid");
+                ToolResult::text(format!(
+                    "✅ Performed private-desktop WinForms {action:?} via {} with semantic post-condition verified.",
+                    receipt.actuator
+                ))
+                .with_structured(json!({
+                    "path": "private_semantic",
+                    "isolation_mode": "private_desktop",
+                    "provider": format!("{:?}", gate.framework),
+                    "action": format!("{action:?}"),
+                    "requested_transport": "win32_message",
+                    "actual_transport": receipt.actuator,
+                    "state_rule": format!("{:?}", gate.decision.state_rule),
+                    "window_state": format!("{:?}", gate.window_state),
+                    "integrity_worker_rid": gate.worker_integrity_rid,
+                    "integrity_target_rid": gate.target_integrity_rid,
+                    "semantic_verified": true,
+                    "postcondition_readback": receipt.postcondition_readback,
+                }))
+                .with_action_record(record)
+            },
+            Ok(Ok(receipt)) if receipt.semantic_verified == Some(false) => {
+                ToolResult::error(format!(
+                    "private_desktop WinForms {action:?} transport completed but its semantic post-condition failed"
+                ))
+                .with_structured(json!({
+                    "code": "postcondition_failed",
+                    "isolation_mode": "private_desktop",
+                    "provider": format!("{:?}", gate.framework),
+                    "action": format!("{action:?}"),
+                    "requested_transport": "win32_message",
+                    "actual_transport": receipt.actuator,
+                    "state_rule": format!("{:?}", gate.decision.state_rule),
+                    "window_state": format!("{:?}", gate.window_state),
+                    "integrity_worker_rid": gate.worker_integrity_rid,
+                    "integrity_target_rid": gate.target_integrity_rid,
+                    "semantic_verified": false,
+                    "postcondition_readback": receipt.postcondition_readback,
+                }))
+            },
+            Ok(Ok(receipt)) => {
+                use cua_driver_core::action_record::{
+                    ActionEffect, ActionExecutionRecord, ActualDelivery, RequestedDelivery,
+                };
+                let record = ActionExecutionRecord::builder(
+                    ActionEffect::Unverifiable,
+                    ActionTransport::WindowsPostMessage,
+                    RequestedDelivery::Background,
+                )
+                .actual_delivery(ActualDelivery::Background)
+                .detail(format!(
+                    "private WinForms {action:?} used {}; provider={:?}; state={:?}; no generic semantic postcondition is available",
+                    receipt.actuator, gate.framework, gate.window_state
+                ))
+                .build()
+                .expect("unverifiable WinForms private action record must be valid");
+                ToolResult::text(format!(
+                    "✅ Performed private-desktop WinForms {action:?} via {}; delivery completed but semantic effect is not generically verifiable.",
+                    receipt.actuator
+                ))
+                .with_structured(json!({
+                    "path": "private_semantic",
+                    "isolation_mode": "private_desktop",
+                    "provider": format!("{:?}", gate.framework),
+                    "action": format!("{action:?}"),
+                    "requested_transport": "win32_message",
+                    "actual_transport": receipt.actuator,
+                    "state_rule": format!("{:?}", gate.decision.state_rule),
+                    "window_state": format!("{:?}", gate.window_state),
+                    "integrity_worker_rid": gate.worker_integrity_rid,
+                    "integrity_target_rid": gate.target_integrity_rid,
+                    "semantic_verified": null,
+                    "postcondition_readback": receipt.postcondition_readback,
+                }))
+                .with_action_record(record)
+            },
+            Ok(Err(error)) => ToolResult::error(error.to_string()).with_structured(json!({
+                "code": "private_native_dispatch_refused",
+                "isolation_mode": "private_desktop",
+                "provider": format!("{:?}", gate.framework),
+                "action": format!("{action:?}"),
+                "window_state": format!("{:?}", gate.window_state),
+            })),
+            Err(error) => ToolResult::error(format!(
+                "private_desktop native dispatch task failed: {error}"
+            ))
+            .with_structured(json!({
+                "code": "private_native_dispatch_failed",
+                "isolation_mode": "private_desktop",
+                "provider": format!("{:?}", gate.framework),
+                "action": format!("{action:?}"),
+                "window_state": format!("{:?}", gate.window_state),
+            })),
+        };
+        let visually_verified = complete_private_visual_result(
+            native_result,
+            environment.clone(),
+            hwnd,
+            visual_baseline,
+        )
+        .await;
+        return complete_private_interference_result(visually_verified, interference);
+    }
+
+    if gate.decision.transport != Some(PrivateActionTransport::UiaPattern) {
+        return ToolResult::error(format!(
+            "private_desktop {action:?} for provider {:?} resolved to no executable strict transport",
+            gate.framework
+        ))
+        .with_structured(json!({
+            "code": "private_transport_unavailable",
+            "isolation_mode": "private_desktop",
+            "provider": format!("{:?}", gate.framework),
+            "action": format!("{action:?}"),
+            "transport": format!("{:?}", gate.decision.transport),
+            "window_state": format!("{:?}", gate.window_state),
+            "integrity_worker_rid": gate.worker_integrity_rid,
+            "integrity_target_rid": gate.target_integrity_rid,
+        }));
+    }
+
+    let admitted_for_action = admitted;
+    let environment_for_action = environment.clone();
+    let dispatched = tokio::task::spawn_blocking(move || {
+        environment_for_action.run_attached_blocking(move || -> anyhow::Result<(String, ActionTransport, Option<bool>, Option<String>)> {
+            use windows::core::Interface;
+            use windows::Win32::UI::Accessibility::{
+                IUIAutomationElement, IUIAutomationInvokePattern,
+                IUIAutomationSelectionItemPattern, IUIAutomationTogglePattern,
+                UIA_InvokePatternId, UIA_SelectionItemPatternId, UIA_TogglePatternId,
+            };
+            let retained = admitted_for_action;
+            if !retained.is_uia() {
+                anyhow::bail!(
+                    "private_desktop semantic click requires a UIA element; element [{idx}] uses another provider"
+                );
+            }
+            let element = std::mem::ManuallyDrop::new(unsafe {
+                IUIAutomationElement::from_raw(retained.as_ptr() as *mut _)
+            });
+            match action {
+                PrivateSemanticAction::Invoke => {
+                    let pattern = unsafe { element.GetCurrentPattern(UIA_InvokePatternId) }
+                        .and_then(|value| value.cast::<IUIAutomationInvokePattern>())
+                        .map_err(|error| anyhow::anyhow!("InvokePattern unavailable: {error}"))?;
+                    unsafe { pattern.Invoke() }
+                        .map_err(|error| anyhow::anyhow!("InvokePattern.Invoke failed: {error}"))?;
+                    Ok((
+                        format!("✅ Performed private-desktop UIA Invoke on [{idx}]."),
+                        ActionTransport::WindowsUiaInvoke,
+                        None,
+                        Some("generic UIA Invoke has no action-local semantic readback contract".into()),
+                    ))
+                }
+                PrivateSemanticAction::Toggle => {
+                    let pattern = unsafe { element.GetCurrentPattern(UIA_TogglePatternId) }
+                        .and_then(|value| value.cast::<IUIAutomationTogglePattern>())
+                        .map_err(|error| anyhow::anyhow!("TogglePattern unavailable: {error}"))?;
+                    let before = unsafe { pattern.CurrentToggleState() }
+                        .map_err(|error| anyhow::anyhow!("TogglePattern pre-state read failed: {error}"))?;
+                    unsafe { pattern.Toggle() }
+                        .map_err(|error| anyhow::anyhow!("TogglePattern.Toggle failed: {error}"))?;
+                    let mut readback = None;
+                    for _ in 0..20 {
+                        if let Ok(after) = unsafe { pattern.CurrentToggleState() } {
+                            if after != before {
+                                readback = Some(format!("UIA_ToggleState:{before:?}->{after:?}"));
+                                break;
+                            }
+                        }
+                        std::thread::sleep(std::time::Duration::from_millis(20));
+                    }
+                    let verified = readback.is_some();
+                    let detail = readback.unwrap_or_else(|| {
+                        let after = unsafe { pattern.CurrentToggleState() }
+                            .map(|value| format!("{value:?}"))
+                            .unwrap_or_else(|_| "<unreadable>".into());
+                        format!("UIA_ToggleState did not change from {before:?}; after={after}")
+                    });
+                    Ok((
+                        format!("✅ Performed private-desktop UIA Toggle on [{idx}]."),
+                        ActionTransport::WindowsUiaToggle,
+                        Some(verified),
+                        Some(detail),
+                    ))
+                }
+                PrivateSemanticAction::Select => {
+                    let pattern = unsafe { element.GetCurrentPattern(UIA_SelectionItemPatternId) }
+                        .and_then(|value| value.cast::<IUIAutomationSelectionItemPattern>())
+                        .map_err(|error| anyhow::anyhow!("SelectionItemPattern unavailable: {error}"))?;
+                    unsafe { pattern.Select() }
+                        .map_err(|error| anyhow::anyhow!("SelectionItemPattern.Select failed: {error}"))?;
+                    let mut verified = false;
+                    for _ in 0..20 {
+                        if unsafe { pattern.CurrentIsSelected() }
+                            .ok()
+                            .is_some_and(|value| value.as_bool())
+                        {
+                            verified = true;
+                            break;
+                        }
+                        std::thread::sleep(std::time::Duration::from_millis(20));
+                    }
+                    Ok((
+                        format!("✅ Performed private-desktop UIA SelectionItem.Select on [{idx}]."),
+                        ActionTransport::WindowsUiaSelection,
+                        Some(verified),
+                        Some(format!("UIA_CurrentIsSelected={verified}")),
+                    ))
+                }
+                PrivateSemanticAction::Value => {
+                    anyhow::bail!("private_desktop click cannot dispatch Value semantics")
+                }
+            }
+        })
+    })
+    .await;
+
+    let dispatched_result = match dispatched {
+        Ok(Ok((message, transport, Some(true), readback))) => {
+            use cua_driver_core::action_record::{
+                ActionEffect, ActionEvidence, ActionExecutionRecord, ActualDelivery,
+                EvidenceKind, RequestedDelivery,
+            };
+            let record = ActionExecutionRecord::builder(
+                ActionEffect::Confirmed,
+                transport,
+                RequestedDelivery::Background,
+            )
+            .actual_delivery(ActualDelivery::Background)
+            .evidence(ActionEvidence {
+                kind: EvidenceKind::AccessibilityReadback,
+                detail: readback.clone().unwrap_or_else(|| "semantic readback matched".into()),
+            })
+            .detail(format!(
+                "private UIA {action:?}; provider={:?}; state={:?}",
+                gate.framework, gate.window_state
+            ))
+            .build()
+            .expect("verified private UIA action record must be valid");
+            ToolResult::text(message)
+                .with_structured(json!({
+                    "path": "private_semantic",
+                    "isolation_mode": "private_desktop",
+                    "provider": format!("{:?}", gate.framework),
+                    "action": format!("{action:?}"),
+                    "semantic_transport": format!("{transport:?}"),
+                    "window_state": format!("{:?}", gate.window_state),
+                    "integrity_worker_rid": gate.worker_integrity_rid,
+                    "integrity_target_rid": gate.target_integrity_rid,
+                    "semantic_verified": true,
+                    "postcondition_readback": readback,
+                }))
+                .with_action_record(record)
+        }
+        Ok(Ok((_message, transport, Some(false), readback))) => {
+            ToolResult::error(format!(
+                "private_desktop UIA {action:?} transport completed but its semantic post-condition failed"
+            ))
+            .with_structured(json!({
+                "code": "postcondition_failed",
+                "isolation_mode": "private_desktop",
+                "provider": format!("{:?}", gate.framework),
+                "action": format!("{action:?}"),
+                "semantic_transport": format!("{transport:?}"),
+                "window_state": format!("{:?}", gate.window_state),
+                "integrity_worker_rid": gate.worker_integrity_rid,
+                "integrity_target_rid": gate.target_integrity_rid,
+                "semantic_verified": false,
+                "postcondition_readback": readback,
+            }))
+        }
+        Ok(Ok((message, transport, None, readback))) => {
+            use cua_driver_core::action_record::{
+                ActionEffect, ActionExecutionRecord, ActualDelivery, RequestedDelivery,
+            };
+            let record = ActionExecutionRecord::builder(
+                ActionEffect::Unverifiable,
+                transport,
+                RequestedDelivery::Background,
+            )
+            .actual_delivery(ActualDelivery::Background)
+            .detail(format!(
+                "private UIA {action:?}; provider={:?}; state={:?}; {}",
+                gate.framework,
+                gate.window_state,
+                readback.as_deref().unwrap_or("no generic semantic postcondition")
+            ))
+            .build()
+            .expect("unverifiable private UIA action record must be valid");
+            ToolResult::text(message)
+                .with_structured(json!({
+                    "path": "private_semantic",
+                    "isolation_mode": "private_desktop",
+                    "provider": format!("{:?}", gate.framework),
+                    "action": format!("{action:?}"),
+                    "semantic_transport": format!("{transport:?}"),
+                    "window_state": format!("{:?}", gate.window_state),
+                    "integrity_worker_rid": gate.worker_integrity_rid,
