+            record.evidence.push(ActionEvidence {
+                kind: EvidenceKind::WindowChange,
+                detail,
+            });
+        }
+        record.visual = Some(ActionVisualReceipt {
+            observer: ActionVisualObserver::PrintWindow,
+            window_state: ActionVisualWindowState::Unknown,
+            baseline_stable: receipt["baseline_stable"].as_bool() == Some(true),
+            mutation_delta_observed: receipt["mutation_changed"]
+                .as_u64()
